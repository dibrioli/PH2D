+/// Para `spikes/regua-registos <pasta>`: o módulo do produto e, por entrada da descida, as constantes da vista
+/// (o `FORA_DESDOBRADO_HRC` 0 e 1; `DISTANTES` 0 e 1).
+fn registos(pasta: &str, vista: &Solver) {
+    let pasta = std::path::PathBuf::from(pasta);
+    std::fs::create_dir_all(&pasta).expect("a pasta");
+    let c = vista.config();
+    let constantes = vista.constantes_da_hrc().expect("a holográfica");
+    let fonte =
+        ph2d_light2d_gpu::fonte_do_rc(c.aritmetica, c.armazenamento, c.hrc_niveis_em_textura());
+    std::fs::write(pasta.join("produto.wgsl"), fonte).expect("o módulo");
+    for entrada in ["hrc_desce", "hrc_desce_um", "hrc_soma"] {
+        for fa in [0, 1] {
+            for d in [0, 1] {
+                let mut l = vec!["modulo produto.wgsl".to_string(), format!("entrada {entrada}")];
+                l.extend(constantes.iter().map(|(k, x)| format!("{k} {x}")));
+                l.push(format!("FORA_DESDOBRADO_HRC {fa}"));
+                l.push(format!("DISTANTES {d}"));
+                std::fs::write(
+                    pasta.join(format!("{entrada}_fa{fa}_d{d}.txt")),
+                    l.join("\n") + "\n",
+                )
+                .expect("as constantes");
+            }
+        }
+    }
+    eprintln!("REGUA · {}", pasta.display());
+}
