+//! **A descida por UM cone sem o `if` de uniforme e o `de_fora` desdobrado** (item 1 da W6i: a conta do `de_fora`
+//! nos níveis 11–12 a 2160p Alta, handoff W6h §13–§14.2). À mão:
+//!
+//! ```text
+//! PH2D_GPU=1 bash scripts/ph2d-run.sh cargo test -p ph2d-app-light2d --profile smoke --test it \
+//!     medida_luz2d_desce_um -- --ignored --nocapture --test-threads=1
+//! ```
+//!
+//! `medida_luz2d_desce_um` (o relógio): cena 5, `[-4.2, -1.8]` h 3,8, a vista do app com o entorno e a borda; as
+//! [`VARIANTES`] são jogos de pipelines no MESMO solver (`Solver::diag_variantes_da_hrc`), trocados A CADA QUADRO
+//! na vista e no entorno, a ordem a rodar por ciclo; o mínimo e a mediana da diferença PAREADA contra o produto
+//! do mesmo ciclo; `A′` é a pipeline gémea (o controlo). Depois (nunca antes) as fases da descida por nível.
+//! `PH2D_DESCE_UM_TETOS=3840x2160:high,1920x1080:low` (omissão: os 9); `PH2D_DESCE_UM_REGISTOS=<pasta>` escreve
+//! os módulos para `spikes/regua-registos`.
+//!
+//! `medida_luz2d_desce_um_bits`: o produto × cada variante, solvers novos, 30 quadros, pela lei do mesmo bit por
+//! placa; as vistas do portão do T nulo + 2160p Alta (`PH2D_DESCE_UM_TODAS=1`: os 9 tetos × 2 câmeras).
+
+use ph2d_app_light2d::qualidade::degrau_do;
+use ph2d_app_light2d::teto::{Tetos, fina_que_cabe};
+use ph2d_app_light2d::{config_da_vista, config_do_entorno, grade_do_quadro, regiao_da_janela};
+use ph2d_editor_core::luz_edits::NivelDaLuz;
+use ph2d_gpu::GpuContext;
+use ph2d_light2d_gpu::Solver;
+use ph2d_render::Camera2d;
+
+use crate::comum::fluencia_lida;
+use crate::medida_luz2d_w4b::loadavg;
+use crate::medida_luz2d_w5o::{mediana, minimo};
+use crate::medida_luz2d_w5v::cena_do_smoke;
+
+const fn niveis(de: u32, ate: u32) -> u32 {
+    (u32::MAX >> (31 - ate)) & !((1u32 << de) - 1)
+}
+
+/// `(nome, desdobrado, os níveis pelo hrc_desce_um)`; o produto é a variante `None`, à parte.
+pub(crate) const VARIANTES: [(&str, bool, u32); 7] = [
+    ("A′", false, 0),
+    ("Fa", true, 0),
+    ("Fc todos", false, u32::MAX),
+    ("Fc 9–12", false, niveis(9, 12)),
+    ("Fc 10–12", false, niveis(10, 12)),
+    ("Fc 11–12", false, niveis(11, 12)),
+    ("Fa+Fc 9–12", true, niveis(9, 12)),
+];
+
+const AQUECE: usize = 4;
+const CICLOS: usize = 40;
+const CICLOS_FASES: usize = 4;
+
+fn nivel_de(s: &str) -> NivelDaLuz {
+    match s {
+        "low" => NivelDaLuz::Baixa,
+        "medium" => NivelDaLuz::Media,
+        _ => NivelDaLuz::Alta,
+    }
+}
+
+fn tetos() -> Vec<((u32, u32), NivelDaLuz)> {
+    let todos = "1920x1080:low,1920x1080:medium,1920x1080:high,2560x1440:low,2560x1440:medium,\
+                 2560x1440:high,3840x2160:low,3840x2160:medium,3840x2160:high";
+    std::env::var("PH2D_DESCE_UM_TETOS")
+        .unwrap_or_else(|_| todos.into())
+        .split(',')
+        .map(|t| {
+            let (r, n) = t.trim().split_once(':').expect("<l>x<a>:<nível>");
+            let (l, a) = r.split_once('x').expect("<l>x<a>");
+            (
+                (l.parse().expect("largura"), a.parse().expect("altura")),
+                nivel_de(n),
+            )
+        })
+        .collect()
+}
+
+fn specs() -> Vec<(bool, u32)> {
+    VARIANTES.iter().map(|v| (v.1, v.2)).collect()
+}
+
+/// A vista e o entorno na ordem do app (a vista renasce com o entorno vivo), com a borda e as variantes.
+fn montar(
+    gpu: &GpuContext,
+    centro: [f32; 2],
+    alvo: (u32, u32),
+    nivel: NivelDaLuz,
+    lado: u32,
+) -> (Solver, Solver, u32) {
+    let a = Camera2d::new(centro, 3.8)
+        .world_to_screen_affine(ph2d_host::WindowSize::new(alvo.0, alvo.1));
+    let tetos = Tetos {
+        lado,
+        recusou: None,
+    };
+    let k = fina_que_cabe(a, alvo, degrau_do(nivel), tetos).expect("nada cabe na placa");
+    let dg = degrau_do(nivel).com_fina_engrossada(k);
+    let g = grade_do_quadro(a, alvo, dg).expect("a grade");
+    let cv = config_da_vista(&gpu.device, g, a, dg);
+    let s = Solver::novo(gpu, cv.clone()).expect("solver da vista");
+    let (i, f) = regiao_da_janela(s.grade_da_fluencia(), a, alvo);
+    let mut e = Solver::novo(gpu, config_do_entorno(&gpu.device, a, alvo, dg).expect("o entorno"))
+        .expect("solver do entorno");
+    e.regiao_fina([0; 2], [0; 2]);
+    assert!(e.mascarar_miolo(
+        gpu,
+        Some([
+            g.origem_m[0],
+            g.origem_m[1],
+            g.origem_m[0] + f64::from(g.largura) * g.texel_m,
+            g.origem_m[1] + f64::from(g.altura) * g.texel_m,
+        ])
+    ));
+    drop(s);
+    let _ = gpu.device.poll(wgpu::PollType::wait_indefinitely());
+    let mut s = Solver::novo(gpu, cv).expect("solver da vista");
+    s.regiao_fina(i, f);
+    assert!(s.somar_entorno(gpu, Some(&e)));
+    let sp = specs();
+    assert_eq!(s.diag_variantes_da_hrc(gpu, &sp), sp.len(), "a vista sem a holográfica");
+    assert_eq!(e.diag_variantes_da_hrc(gpu, &sp), sp.len(), "o entorno sem a holográfica");
+    (s, e, k)
+}
+
+fn nome(v: Option<usize>) -> &'static str {
+    v.map_or("A", |v| VARIANTES[v].0)
+}
