+/// A pista exacta que sobra: entre duas imagens, quantas linhas têm uma entrada da óptica diferente ao bit? Com o filme
+/// (o que a óptica lê) e sem ele (só a massa e a cor da tinta).
+#[test]
+#[ignore = "régua: corre por nome com --ignored"]
+fn regua_do_fecho_censo_das_entradas() {
+    for (w, h) in TAMANHOS {
+        let mut t = pintada(w, h, 10);
+        t.preset_aplicar(&preset("Watercolor/Fluid/Wet Round.ph2d-brush.png"))
+            .expect("o meio");
+        t.set_brush_size_px(60.0);
+        for r in 0..5usize {
+            traco_inteiro(&mut t, w, 40.0 + 90.0 * r as f32);
+            for quadros in [6usize, 25, 100] {
+                let sess = t.paint.wetpaint.session.as_mut().expect("sessão");
+                sess.bring_home();
+                let (film, susp, susp_rgb, sett, sett_rgb) = {
+                    let g = sess.engine.active_grid();
+                    (
+                        g.film.clone(),
+                        g.susp.clone(),
+                        g.susp_rgb.clone(),
+                        g.sett.clone(),
+                        g.sett_rgb.clone(),
+                    )
+                };
+                for _ in 0..quadros {
+                    quadro(&mut t);
+                }
+                let sess = t.paint.wetpaint.session.as_mut().expect("sessão");
+                sess.bring_home();
+                let (gw, gh) = sess.grid;
+                let g = sess.engine.active_grid();
+                let t0 = Instant::now();
+                let (mut com, mut sem) = (vec![false; gh], vec![false; gh]);
+                for cy in 1..=gh {
+                    let f = cy * g.s..(cy + 1) * g.s;
+                    let massa = susp[f.clone()] != g.susp[f.clone()]
+                        || sett[f.clone()] != g.sett[f.clone()]
+                        || susp_rgb[f.clone()] != g.susp_rgb[f.clone()]
+                        || sett_rgb[f.clone()] != g.sett_rgb[f.clone()];
+                    sem[cy - 1] = massa;
+                    com[cy - 1] = massa || film[f.clone()] != g.film[f];
+                }
+                let ms = t0.elapsed().as_secs_f64() * 1e3;
+                let vivas = (1..=gh).filter(|&y| g.row_lo[y] <= g.row_hi[y]).count();
+                println!(
+                    "[entradas] {w}×{h} a{r} {quadros} quadros: {gw}×{gh} | linhas (+9) com filme {} sem filme {} vivas {vivas} | comparar {ms:.1} ms",
+                    linhas_crescidas(&com, 9),
+                    linhas_crescidas(&sem, 9),
+                );
+            }
+        }
+    }
+    println!("[entradas] carga {}", carga());
+}
