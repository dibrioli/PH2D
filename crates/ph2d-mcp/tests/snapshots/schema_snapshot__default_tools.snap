- name: scene.delete_entity
  description: Despawn an entity. Destructive — requires confirmation_token (HR-11).
  destructive: true
- name: scene.get_component
  description: Read a component by name from an entity.
  destructive: false
- name: scene.spawn_entity
  description: "Spawn empty entity, returns Entity handle."
  destructive: false
