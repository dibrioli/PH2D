+/// ⭐ **O comprimento da JANELA da largura** (px, comissão de velocidade 29/10 item H): o traço RECTO que a régua lê
+/// (o dos pincéis e o vão dos misturadores) tem este comprimento a todo o raio, e a tela só a altura que o raio pede —
+/// o custo cresce com `r`, não com `r²` (a de antes: tela de 1 000 px e misturador `800 + 2·(m + 100)`). A largura é a
+/// MESMA: medida no doc da comissão §H. `PH2D_JANELA_DA_LARGURA=<px>` muda-a, `=antiga` volta à cena de antes (as
+/// variantes no MESMO binário, MEDIR_VELOCIDADE).
+const JANELA_DA_LARGURA: f32 = 200.0;
+/// A margem de cada lado da janela: o traço nasce e acaba nela (a ponta redonda fica fora das colunas lidas).
+const MARGEM_DA_JANELA: f32 = 100.0;
+
+/// A janela em vigor: `None` = a cena antiga.
+fn janela_da_largura() -> Option<f32> {
+    static J: std::sync::OnceLock<Option<f32>> = std::sync::OnceLock::new();
+    *J.get_or_init(|| match std::env::var("PH2D_JANELA_DA_LARGURA").as_deref() {
+        // ⛔ 29/10: a janela de 200 px NÃO bate com a cena antiga (20 raios fora no portão, os misturadores e as
+        // espátulas a raio ≥ 55) — a antiga fica por omissão; `=janela` liga a de 200, `=<px>` outra.
+        Ok("janela") => Some(JANELA_DA_LARGURA),
+        Ok(v) => Some(v.parse().expect("PH2D_JANELA_DA_LARGURA: px, «janela» ou nada")),
+        Err(_) => None,
+    })
+}
