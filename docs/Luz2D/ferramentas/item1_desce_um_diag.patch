+/// O produto × cada variante, solvers novos (o estado acumulado é o mesmo só com a mesma história).
+#[test]
+#[ignore = "medição de placa: o bit das variantes do item 1 (W6i)"]
+fn medida_luz2d_desce_um_bits() {
+    let Some(gpu) = crate::comum::gpu() else {
+        return;
+    };
+    let info = gpu.adapter.get_info();
+    eprintln!("P placa {:?} · driver {:?} {:?}", info.name, info.driver, info.driver_info);
+    let cena = cena_do_smoke(5);
+    let mut casos = vec![
+        (NivelDaLuz::Baixa, [-4.2, -1.8], (1920, 1080)),
+        (NivelDaLuz::Alta, [-4.2, -1.8], (1920, 1080)),
+        (NivelDaLuz::Media, [-3.2, -1.8], (2560, 1440)),
+        (NivelDaLuz::Baixa, [-3.2, -1.8], (3840, 2160)),
+        (NivelDaLuz::Alta, [-4.2, -1.8], (3840, 2160)),
+    ];
+    if std::env::var("PH2D_DESCE_UM_TODAS").as_deref() == Ok("1") {
+        casos.clear();
+        for centro in [[-4.2, -1.8], [-3.2, -1.8]] {
+            for (alvo, nivel) in tetos() {
+                casos.push((nivel, centro, alvo));
+            }
+        }
+    }
+    let reescreve = info.driver.to_lowercase().contains("radv") || info.name.contains("RADV");
+    for (nivel, centro, alvo) in casos {
+        let luz = |v: Option<usize>| {
+            let (mut s, mut e, _) = montar(&gpu, centro, alvo, nivel, 8192);
+            e.diag_variante_da_hrc(&gpu, v);
+            s.diag_variante_da_hrc(&gpu, v);
+            for _ in 0..30 {
+                e.quadro(&gpu, &cena);
+                assert!(s.somar_entorno(&gpu, Some(&e)));
+                s.quadro(&gpu, &cena);
+            }
+            let f = fluencia_lida(&gpu, &s).v;
+            drop((s, e));
+            let _ = gpu.device.poll(wgpu::PollType::wait_indefinitely());
+            f
+        };
+        let produto = luz(None);
+        let acesos = produto.iter().filter(|v| v.iter().any(|c| *c > 0.0)).count();
+        assert!(acesos > 0, "a vista às escuras não prova nada");
+        for iv in 0..VARIANTES.len() {
+            let b = luz(Some(iv));
+            let (dif, pior) = diferencas(&produto, &b);
+            let passa = if reescreve { pior <= 1 } else { dif == 0 };
+            eprintln!(
+                "B {alvo:?} {nivel:?} {centro:?} ({acesos} acesos) · {:<11} · {dif} texels, o pior {pior} ULP · {}",
+                VARIANTES[iv].0,
+                if passa { "PASSA" } else { "REPROVA" }
+            );
+        }
+    }
+}
