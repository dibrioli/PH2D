# Rust
target/

# `backups/` — verbatim snapshot of crates+docs before the watercolor v2
# super-simplification (tracked since commit `30ecc096` as a refactor safety net).
# It is NOT active source; gitignoring it makes the lint tools (cargo-machete,
# typos — both honour .gitignore) skip its stale Cargo.toml deps + pt-BR docs,
# which were reddening CI. The files stay tracked (already committed) for the user.
backups/

# Secrets — the dev/test Anthropic API key (P4, ADR-0061). Read in debug builds
# by ph2d-host-desktop; MUST NEVER be committed.
docs/_api-claude.md

# macOS
.DS_Store

# Editors
*.swp
*.swo
*~
.idea/
# .vscode/ is COMMITTED — shared workspace settings (luau-lsp + rust-analyzer config)
.vscode/launch.json
.vscode/tasks.json

# Node / web shell
node_modules/
dist/
runtime/ts/dist/

# Build artifacts
*.pdb
*.dSYM/

# Local env
.env
.env.local

# insta pending snapshots (review with `cargo insta review` then accept)
*.snap.new

# pre-commit cache
.pre-commit-state

# Demo PNG fixtures auto-generated by the desktop shell on first
# launch (shells/desktop/src/integration.rs). Keeping the repo binary-
# free; regenerated deterministically per the golden-angle hue cycle.
assets/sprites/*.png

# Claude Design hands off a `uploads/` folder with reference images
# (Procreate screenshots, drawing app captures) used as input — not
# part of the design system deliverable. Gitignored to keep repo lean
# and avoid committing third-party screenshots with unclear licenses.
docs/design/uploads/

# Vendored Blender Texture Paint source — GPL-2.0, kept ONLY as a
# clean-room study reference (never committed: PH2D is proprietary).
# Also keeps its source out of the `typos` scan (Blender's own typos).
reference/

# Claude Code session-local artifacts: agent worktrees (isolated git
# checkouts spawned by the Agent tool) and any other harness state
# under .claude/. These are per-machine and should never enter repo.
.claude/

# Wave 10 / slot-env.sh — per-session cargo target dirs (never committed)
target-slots/

# Modo L (DIRETRIZ §1.5) — per-line git worktrees live INSIDE the repo so
# every Claude Code window can open at the repo root. Never tracked by the
# primary checkout; each worktree is its own full checkout of line/<módulo>.
/Worktrees/

# Vector Pen scratch — defense-in-depth only. Auto-save was REMOVED in
# 3617672 (W1 is in-memory only); these patterns guard against an
# accidental reintroduction or a future W2 scratch dir.
# See docs/AUDIT_vector_module_W1_results.md C1-C3.
vector_pen_*.ph2d-vector
target/vector-scratch/

# Artefatos de save local do editor (smoke)
ph2d_project.postcard
ph2d_vec_scene.postcard

# MVPs paralelos e ferramental local: projetos AINDA sem associação com o PH2D.
# TUDO local, fora do git em TODA máquina (decisão Enio 2026-07-23 / 2026-07-25).
docs/Pixel Art/
docs/Tilling/
docs/PromptDeck/
scripts/prompt-deck.py
scripts/prompt-deck-sync.py

# Obsidian per-machine workspace state for the docs/3D vault (the notes are versioned, the pane layout is not).
docs/3D/.obsidian/
