{
  "type": "excalidraw",
  "version": 2,
  "source": "ph2d-miroclone-oracle-input",
  "ph2d_note": "esqueleto: seta elbowed:true entre origem e destino com um obstáculo no meio",
  "elements": [
    {
      "type": "rectangle",
      "id": "origem",
      "x": 40,
      "y": 160,
      "width": 140,
      "height": 90,
      "label": {
        "text": "origem"
      }
    },
    {
      "type": "rectangle",
      "id": "obstaculo",
      "x": 280,
      "y": 120,
      "width": 120,
      "height": 170,
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid"
    },
    {
      "type": "rectangle",
      "id": "destino",
      "x": 500,
      "y": 160,
      "width": 140,
      "height": 90,
      "label": {
        "text": "destino"
      }
    },
    {
      "type": "arrow",
      "id": "cotovelo",
      "x": 180,
      "y": 205,
      "width": 320,
      "height": 0,
      "elbowed": true,
      "start": {
        "id": "origem"
      },
      "end": {
        "id": "destino"
      }
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff"
  },
  "files": {}
}
