+/// O traço de [`traco_recto_alto_com`] numa tela de `janela + 2·margem` de largura, e a imagem RECORTADA às colunas da
+/// janela (as da recta: a ponta redonda e o seu sino ficam de fora).
+fn traco_da_janela(
+    size: f32,
+    alto: f32,
+    janela: f32,
+    r: Relogio,
+    prepara: impl FnOnce(&mut PainterTool),
+) -> (Vec<u8>, u32, u32) {
+    use ph2d_editor_core::tool::RasterEditTool;
+    let (m, j) = (MARGEM_DA_JANELA as u32, janela as u32);
+    let w = j + 2 * m;
+    let h = ((alto * 6.0) as u32 + 80).max(120);
+    let cy = h as f32 * 0.5;
+    let mut t = PainterTool::default();
+    t.set_source(vec![255u8; (w * h * 4) as usize], w, h);
+    prepara(&mut t);
+    t.set_brush_size_px(size);
+    t.set_brush_color_srgb8(crate::sonda_gestos::AZUL);
+    crate::sonda_gestos::gesto(&mut t, &[[m as f32, cy], [(m + j) as f32, cy]], 3.0, |_| 1.0);
+    passa_o_tempo(&mut t, QUADROS_DA_LEI, r);
+    let (px, w, h) = t.run_full();
+    let recorte = (0..h)
+        .flat_map(|y| {
+            let i = ((y * w + m) * 4) as usize;
+            px[i..i + (j * 4) as usize].to_vec()
+        })
+        .collect();
+    (recorte, j, h)
+}
