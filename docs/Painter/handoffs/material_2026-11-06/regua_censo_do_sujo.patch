+/// Fracção das linhas de `l` (em `0..n`) marcadas depois de crescer cada uma por `a`.
+fn linhas_crescidas(l: &[bool], a: usize) -> usize {
+    let mut v = vec![false; l.len()];
+    for (y, _) in l.iter().enumerate().filter(|(_, m)| **m) {
+        for m in &mut v[y.saturating_sub(a)..(y + a + 1).min(l.len())] {
+            *m = true;
+        }
+    }
+    v.iter().filter(|m| **m).count()
+}
