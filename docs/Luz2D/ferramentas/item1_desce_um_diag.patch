+        }
+        let par = |t: &[Vec<f64>], iv: usize| {
+            let d: Vec<f64> = t[iv].iter().zip(&t[0]).map(|(x, a)| x - a).collect();
+            mediana(&d)
+        };
+        for (iv, v) in vars.iter().enumerate() {
+            eprintln!(
+                "C {rotulo} · {:<11} · vista c2 mín {:.3} med {:.3} · − A mín {:+.3} par {:+.3} ({:+.2} %) · entorno mín \
+                 {:.3} − A {:+.3} par {:+.3}",
+                nome(*v),
+                minimo(&vista[iv]),
+                mediana(&vista[iv]),
+                minimo(&vista[iv]) - minimo(&vista[0]),
+                par(&vista, iv),
+                100.0 * par(&vista, iv) / minimo(&vista[0]),
+                minimo(&ent[iv]),
+                minimo(&ent[iv]) - minimo(&ent[0]),
+                par(&ent, iv),
+            );
+        }
+        eprintln!("R {rotulo} · load {}", loadavg().trim());
+
+        // As fases por nível (o modo de fases acrescenta fronteira de passe; a `c2` acima é a que decide).
+        assert!(s.medir_fases_da_hrc(&gpu));
+        let mut fases: Vec<Vec<(&'static str, u32, Vec<f64>)>> = vec![Vec::new(); nv];
+        for c in 0..1 + CICLOS_FASES {
+            for i in 0..nv {
+                let iv = (i + c) % nv;
+                quadro(&mut s, &mut e, vars[iv]);
+                if c == 0 {
+                    continue;
+                }
+                for (etapa, n, ms, _) in s.fases_da_hrc(&gpu).expect("fases") {
+                    match fases[iv].iter_mut().find(|o| o.0 == etapa && o.1 == n) {
+                        Some(o) => o.2.push(ms),
+                        None => fases[iv].push((etapa, n, vec![ms])),
+                    }
+                }
+            }
+        }
+        let ler = |iv: usize, n: u32| {
+            fases[iv]
+                .iter()
+                .find(|o| o.0 == "hrc_desce" && o.1 == n)
+                .map_or(0.0, |o| minimo(&o.2))
+        };
+        let nomes: Vec<&str> = vars.iter().map(|v| nome(*v)).collect();
+        eprintln!("F {rotulo} · desce por nível · {}", nomes.join(" · "));
+        let mut ns: Vec<u32> = fases[0]
+            .iter()
+            .filter(|o| o.0 == "hrc_desce")
+            .map(|o| o.1)
+            .collect();
+        ns.sort_unstable();
+        for n in ns {
+            let l: Vec<String> = (0..nv).map(|iv| format!("{:.3}", ler(iv, n))).collect();
+            eprintln!("F {rotulo} · desce n {n:>2} · {}", l.join(" · "));
+        }
+        drop((s, e));
+        let _ = gpu.device.poll(wgpu::PollType::wait_indefinitely());
+    }
+}
