+/// O raio GRANDE (do motor, um ponto de [`raios_da_lei`]) onde a régua de antes do [`faixas_da_base`] mentia: a lei crua
+/// do Blender Soft caía de 248 px (723,6) a 0 (990,6) com a base presa a 1 024 px. A janela de comprimento fixo
+/// ([`janela_da_largura`]) não pode esconder um defeito só de raio grande: este portão mede-o.
+const RAIO_GRANDE_DA_REGUA: f32 = 990.6;
+
+/// ⭐ **A régua dos misturadores vale no raio GRANDE** (comissão 29/10 item H): a lei crua de cada misturador de fábrica
+/// (toda ferramenta menos o Smear, as da [`faixas_da_base`]) a [`RAIO_GRANDE_DA_REGUA`] é a da TABELA gravada nesse raio,
+/// na tolerância da promessa — e não é 0. Com a base de UM traço (a régua que mentia) o Blender Soft lê 0.
+#[test]
+fn a_regua_dos_misturadores_vale_no_raio_grande() {
+    let presets: Vec<Preset> = ficheiros_do_wet()
+        .into_iter()
+        .map(|(_, b)| ler(&b).unwrap())
+        .filter(|p| {
+            p.parametros
+                .paint_mode
+                .as_deref()
+                .is_some_and(|m| m != "Paint" && m != "Smear")
+        })
+        .collect();
+    assert!(
+        presets.len() >= 4,
+        "os misturadores de fábrica: {}",
+        presets.len()
+    );
+    let medidas: Vec<f32> = std::thread::scope(|s| {
+        let h: Vec<_> = presets
+            .iter()
+            .map(|p| s.spawn(move || largura_de_com(p, RAIO_GRANDE_DA_REGUA, true, Relogio::PorQuadro)))
+            .collect();
+        h.into_iter().map(|h| h.join().unwrap()).collect()
+    });
+    let mut falhas = Vec::new();
+    for (p, l) in presets.iter().zip(medidas) {
+        let nome = &p.parametros.name;
+        let gravada = p
+            .parametros
+            .width_table
+            .iter()
+            .find(|[r, _]| (*r - f64::from(RAIO_GRANDE_DA_REGUA)).abs() < 0.05)
+            .map(|&[_, l]| l as f32)
+            .unwrap_or_else(|| panic!("{nome}: a tabela sem o raio {RAIO_GRANDE_DA_REGUA}"));
+        let tol = TOLERANCIA_PX.max(tolerancia_da_largura(p) * gravada);
+        println!("[raio grande] {nome:<17} {l:.1} px · tabela {gravada} (± {tol:.1})");
+        if l <= 0.0 || (l - gravada).abs() > tol {
+            falhas.push(format!("{nome}: {l} px a {RAIO_GRANDE_DA_REGUA}, a tabela diz {gravada}"));
+        }
+    }
+    assert!(falhas.is_empty(), "a régua não vale no raio grande:\n{}", falhas.join("\n"));
