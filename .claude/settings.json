{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//home/enio/Documentos/Projetos/UnrealEngine/Engine/Source/**)",
      "Read(//home/enio/Documentos/Projetos/UnrealEngine/Engine/Shaders/**)",
      "Read(//home/enio/Apps/UnrealEngine/Engine/Source/**)",
      "Read(//home/enio/Apps/UnrealEngine/Engine/Shaders/**)",
      "Read(//usr/share/blender/*/scripts/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tecto-de-recursos.sh",
            "timeout": 10,
            "statusMessage": "a conferir os tectos de recurso da linha"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-barato.sh",
            "timeout": 10,
            "statusMessage": "a conferir o commit (tectos, fmt, HR-15)"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prazo-do-agente.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prazo-do-agente.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/prazo-do-agente.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/tamanho-da-conversa.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
