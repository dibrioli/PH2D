[Unit]
Description=PH2D: devolve blocos de dados meio-vazios ao espaco nao-alocado do btrfs (metadata precisa dele para crescer)
Documentation=file:///home/enio/Documentos/Projetos/PH2D/docs/DevOps/BTRFS_METADATA_E_SWAP.md
ConditionPathIsMountPoint=/

[Service]
Type=oneshot
# TRAVA (medido 2026-08-22): um balance REESCREVE dados. Num boot em que o kernel
# ja devolveu arquivo com checksum errado, relocar blocos e arriscar corromper o
# que ainda esta bom -- e o proprio balance aborta em EIO no primeiro extent ruim.
# ExecCondition falhando = unidade PULADA (nao "failed"), e o journal diz por que.
ExecCondition=/bin/sh -c '! journalctl -k -b --no-pager -q | grep -q "csum failed" || { echo "pulado: csum failed neste boot -- troque de kernel/scrub antes (docs/DevOps/BTRFS_METADATA_E_SWAP.md §3)"; exit 1; }'
# Progressivo e barato: so relocaliza blocos <=10% e depois <=25% cheios.
# Um balance de metadata NAO entra aqui de proposito (ver runbook, Recusas).
ExecStart=/usr/bin/btrfs balance start -dusage=10 /
ExecStart=/usr/bin/btrfs balance start -dusage=25 /
Nice=19
IOSchedulingClass=idle
