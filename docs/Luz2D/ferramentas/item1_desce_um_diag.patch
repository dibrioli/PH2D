+/// `(texels diferentes, o pior em ULP do f16)` — a contagem do `mesmo_bit_por_placa`, sem reprovar.
+fn diferencas(a: &[[f32; 3]], b: &[[f32; 3]]) -> (usize, u16) {
+    let ulps = |x: f32, y: f32| {
+        half::f16::from_f32(x)
+            .to_bits()
+            .abs_diff(half::f16::from_f32(y).to_bits())
+    };
+    let (mut d, mut pior) = (0, 0);
+    for (x, y) in a.iter().zip(b) {
+        if x != y {
+            d += 1;
+            pior = pior.max((0..3).map(|c| ulps(x[c], y[c])).max().unwrap_or(0));
+        }
+    }
+    (d, pior)
+}
