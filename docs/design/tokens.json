{
  "$meta": {
    "name": "ph2d-tokens",
    "version": "0.1.0",
    "default-theme": "forge",
    "color-space": "oklch",
    "notes": "Machine-readable tokens for the PH2D editor. Consumed by HTML/CSS via styles/tokens.css and by Rust codegen downstream."
  },
  "themes": {
    "forge": {
      "panel-layout": "floating",
      "color": {
        "bg-0":           "oklch(0.135 0.006 285)",
        "bg-1":           "oklch(0.170 0.007 285)",
        "bg-2":           "oklch(0.205 0.008 285)",
        "bg-3":           "oklch(0.250 0.010 285)",
        "bg-elev":        "oklch(0.220 0.008 285 / 0.86)",
        "bg-scrim":       "oklch(0.080 0.005 285 / 0.55)",
        "border":         "oklch(0.295 0.011 285)",
        "border-strong":  "oklch(0.500 0.018 285)",
        "border-emph":    "oklch(0.560 0.020 285)",
        "text-1":         "oklch(0.965 0.004 285)",
        "text-2":         "oklch(0.745 0.007 285)",
        "text-3":         "oklch(0.560 0.009 285)",
        "text-disabled":  "oklch(0.420 0.008 285)",
        "accent":         "oklch(0.740 0.160 340)",
        "accent-hover":   "oklch(0.790 0.165 340)",
        "accent-press":   "oklch(0.690 0.155 340)",
        "accent-soft":    "oklch(0.740 0.160 340 / 0.16)",
        "accent-fg":      "oklch(0.150 0.030 340)",
        "danger":         "oklch(0.660 0.200 25)",
        "danger-soft":    "oklch(0.660 0.200 25 / 0.16)",
        "success":        "oklch(0.745 0.140 155)",
        "success-soft":   "oklch(0.745 0.140 155 / 0.16)",
        "warn":           "oklch(0.800 0.140 80)",
        "warn-soft":      "oklch(0.800 0.140 80 / 0.16)",
        "info":           "oklch(0.720 0.120 235)",
        "info-soft":      "oklch(0.720 0.120 235 / 0.16)",
        "selection":      "oklch(0.740 0.160 340 / 0.24)",
        "focus-ring":     "oklch(0.740 0.160 340 / 0.55)",
        "grid-line":      "oklch(1 0 0 / 0.04)",
        "grid-axis":      "oklch(0.740 0.160 340 / 0.32)",
        "canvas":         "oklch(0.105 0.004 285)"
      },
      "spacing": { "xxs": "2px", "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "2xl": "24px", "3xl": "32px", "4xl": "48px" },
      "radius":  { "xs": "4px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "2xl": "20px", "full": "999px" },
      "shadow": {
        "sm": "0 1px 2px oklch(0 0 0 / 0.4)",
        "md": "0 4px 14px oklch(0 0 0 / 0.32), 0 1px 2px oklch(0 0 0 / 0.4)",
        "lg": "0 18px 48px oklch(0 0 0 / 0.55), 0 2px 6px oklch(0 0 0 / 0.45)",
        "inset-hi": "inset 0 1px 0 oklch(1 0 0 / 0.04)"
      },
      "row-h": "28px",
      "icon-btn-size": "36px",
      "section-gap": "14px"
    },
    "workshop":  { "$inherits": "forge", "color": { "accent": "oklch(0.780 0.140 205)", "accent-hover": "oklch(0.820 0.140 205)", "accent-press": "oklch(0.730 0.140 205)", "accent-soft": "oklch(0.780 0.140 205 / 0.16)", "focus-ring": "oklch(0.780 0.140 205 / 0.55)", "selection": "oklch(0.780 0.140 205 / 0.24)" } },
    "sunstone":   { "panel-layout": "floating", "color": { "bg-0": "oklch(0.985 0.006 75)", "bg-1": "oklch(0.965 0.008 75)", "bg-2": "oklch(0.940 0.010 75)", "bg-3": "oklch(0.910 0.014 75)", "border": "oklch(0.870 0.016 75)", "border-strong": "oklch(0.640 0.018 75)", "text-1": "oklch(0.220 0.014 75)", "text-2": "oklch(0.420 0.012 75)", "text-3": "oklch(0.560 0.010 75)", "accent": "oklch(0.560 0.190 55)", "warn": "oklch(0.560 0.160 80)", "canvas": "oklch(0.945 0.012 75)" } },
    "blueprint":  { "panel-layout": "sidebar", "color": { "bg-0": "oklch(0.975 0.008 250)", "bg-1": "oklch(0.955 0.010 250)", "bg-2": "oklch(0.925 0.014 250)", "border": "oklch(0.860 0.018 250)", "border-strong": "oklch(0.620 0.020 250)", "text-1": "oklch(0.220 0.020 250)", "accent": "oklch(0.500 0.180 250)", "warn": "oklch(0.560 0.160 80)", "canvas": "oklch(0.940 0.016 250)" } }
  },
  "typography": {
    "font-sans":    "'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif",
    "font-display": "'Inter Display', 'Inter', system-ui, sans-serif",
    "font-mono":    "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "size":   { "xxs": "10px", "xs": "11px", "sm": "12px", "base": "13px", "md": "15px", "lg": "18px", "xl": "24px", "2xl": "32px", "3xl": "44px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "line":   { "tight": 1.15, "snug": 1.3, "normal": 1.45, "loose": 1.6 },
    "track":  { "tight": "-0.02em", "normal": "0", "wide": "0.04em", "caps": "0.08em" }
  },
  "motion": {
    "ease": {
      "out":    "cubic-bezier(0.2, 0.7, 0.1, 1)",
      "inout":  "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "duration": { "instant": "80ms", "fast": "150ms", "default": "240ms", "slow": "400ms" }
  },
  "z": { "canvas": 0, "panel": 10, "overlay": 20, "modal": 30, "toast": 40, "tooltip": 50 }
}
